meta {
  name: List Users
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/admin/users
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns user list", function() {
    expect(res.getBody().data).to.be.an("array");
    expect(res.getBody().data.length).to.be.greaterThan(0);
  });

  test("does not expose password", function() {
    expect(res.getBody().data[0].password).to.be.undefined;
  });
}
