meta {
  name: Admin Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@example.com",
    "password": "password"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("token", res.getBody().data.token);
  }
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns admin bearer token", function() {
    expect(res.getBody().data.token_type).to.equal("Bearer");
    expect(res.getBody().data.user.role).to.equal("admin");
  });
}
