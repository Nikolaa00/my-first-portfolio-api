meta {
  name: Update Transaction
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/transactions/{{transactionId}}
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "asset_id": {{assetId}},
    "type": "sell",
    "quantity": 5.25,
    "price": 175.50,
    "price_currency": "EUR",
    "executed_at": "2026-02-01T14:00:00"
  }
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns updated transaction", function() {
    expect(res.getBody().data.type).to.equal("sell");
  });
}
