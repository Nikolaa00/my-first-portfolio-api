meta {
  name: Create Transaction
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/portfolios/{{portfolioId}}/transactions
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "asset_id": {{assetId}},
    "type": "buy",
    "quantity": 10.5,
    "price": 150.25,
    "price_currency": "USD",
    "executed_at": "2026-01-15T10:30:00"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("transactionId", res.getBody().data.id);
  }
}

tests {
  test("returns 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns transaction data", function() {
    expect(res.getBody().data.type).to.equal("buy");
    expect(res.getBody().data.portfolio_id).to.equal(parseInt(bru.getEnvVar("portfolioId")));
  });
}
