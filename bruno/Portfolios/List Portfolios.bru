meta {
  name: List Portfolios
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/portfolios
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns portfolio list", function() {
    expect(res.getBody().data).to.be.an("array");
  });
}
