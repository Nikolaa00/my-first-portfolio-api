meta {
  name: Logout
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/logout
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("token", "");
  }
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("confirms logout", function() {
    expect(res.getBody().message).to.equal("Logged out successfully.");
  });
}
